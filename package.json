{
  "name": "whatsapp-webhook",
  "version": "1.0.0",
  "private": true,
  "description": "Webhook multi-cliente para la WhatsApp Cloud API (Ideam Estudi Creatiu, Tech Provider)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "onboarding-link": "tsx --env-file=.env src/scripts/onboarding-link.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.10.0",
    "@azure/keyvault-secrets": "^4.10.0",
    "express": "^5.1.0",
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/mssql": "^9.1.7",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
