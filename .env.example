# Token que inventas tú y pones también en Meta > App > WhatsApp > Configuración > Webhook
VERIFY_TOKEN=pon-aqui-un-texto-largo-y-aleatorio

# Meta > App > Configuración de la app > Básica > Clave secreta de la app
APP_SECRET=

# Meta > App > Configuración de la app > Básica > Identificador de la app
APP_ID=1049358144785376

# Meta > App > Inicio de sesión con Facebook para empresas > Configuraciones (Embedded Signup)
# Plantilla oficial "Registro insertado de WhatsApp": el token de cada cliente caduca a los ~60 días
ES_CONFIG_ID=3088650604806569

# Token por defecto (usuario del sistema de IDEAM Studio). Si un cliente tiene su propio
# token (Embedded Signup) se guarda en dbo.WhatsAppAccounts.AccessToken y se usa ese.
ACCESS_TOKEN=

# Azure SQL. En Azure: identidad administrada de la web app, sin contraseña
SQL_SERVER=sql-whatsapp-prod-ideam.database.windows.net
SQL_DATABASE=whatsapp
# En local, en su lugar, una cadena de conexión con usuario y contraseña (tiene prioridad si se define):
# SQL_CONNECTION_STRING=Server=tcp:SERVIDOR.database.windows.net,1433;Database=whatsapp;User Id=USUARIO;Password=CONTRASEÑA;Encrypt=true

# Opcionales
GRAPH_API_VERSION=v27.0
PORT=3000
# Si se define, activa POST /api/messages (cabecera x-api-key) para enviar mensajes desde otras herramientas
INTERNAL_API_KEY=
